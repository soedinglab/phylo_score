rule decompress_rfam_seed:
    input:
        "data/Rfam.seed_v15.1.gz"
    output:
        "data/Rfam.seed_v15.1"
    localrule: True
    shell:
        "gzip -cd {input} > {output}"

rule extract_stockholm_alignment:
    input:
        "data/Rfam.seed_v15.1"
    output:
        "data/datasets/{dataset}.sto"
    localrule: True
    shell:
        """
        test -f {input}.ssi || esl-afetch --index {input}
        esl-afetch {input} {wildcards.dataset} > {output}
        """

rule prepare_rfam:
    input:
        "prepare_rfam.py",
        "data/datasets/{dataset}.sto"
    output:
        "data/{dataset, [^/]+}/alignment.fasta",
        "data/{dataset, [^/]+}/ss.txt",
        "data/{dataset, [^/]+}/alignment.sto"
    localrule: True
    shell:
        "python {input[0]} {input[1]} {output[0]} {output[1]} {output[2]}"

rule phylogeny:
    input:
        "data/{dataset}/alignment.fasta"
    output:
        "data/{dataset, [^/]+}/raxml.newick"
    threads: 16
    resources:
        mem_mb = 10000,
        runtime = 100
    shell:
        "raxml-ng --msa {input} --model GTR+G --prefix {output} --seed 1 --redo --msa-format fasta --blopt nr_safe && mv {output}.raxml.bestTree {output}"

rule run_phylo_score:
    input:
        "data/{dataset}/alignment.fasta",
        "data/{dataset}/raxml.newick"
    output:
        "data/{dataset, [^/]+}/reg{reg}_mireg{mireg}_score{score}_corr{corr}.npz"
    threads: 64
    resources:
        mem_mb = 100000,
        runtime = 10000
    shell:
        "python -m phylo_score --alignment {input[0]} --tree {input[1]} --lambda {wildcards.reg} --lambda-mi {wildcards.mireg} --score-type {wildcards.score} --correction {wildcards.corr} --output {output}"

RF = list(map(str.strip, open("3d.txt", "r")))

rule hyperparameter_collection:
    input:
        eval = expand(
            "data/{dataset}/reg{reg}_mireg{mireg}_score{score}_corr{corr}.npz",
            dataset = RF,
            score = ["optdiff"],
            corr = ["APC"],
            reg = [0.5],
            mireg = [0.01],
        ),
    output:
        "data/hyper_temp.txt",
    localrule: True
    shell:
        "touch {output}"

rule rscape:
	input:
		"data/{dataset}/alignment.sto"
	output:
		"data/{dataset}/rscape/{score}.cov"
	localrule: True
	shell:
		"./R-scape -E 1001 --outdir data/{wildcards.dataset}/rscape --gapthresh 1.0 --outname {wildcards.score} --{wildcards.score} {input}"

rule extract_rscape:
	input:
		rscape = "data/{dataset}/rscape/{score}.cov"
	output:
		"data/{dataset}/rscape_{score}.npz"
	localrule: True
	script:
		"extract_rscape.py"

rule eval:
    input:
        scores = "data/{dataset}/reg{reg}_mireg{mireg}_score{score}_corr{corr}.npz",
        ss = "data/{dataset}/ss.txt",
    output:
        "data/{dataset}/eval_reg{reg}_mireg{mireg}_score{score}_corr{corr}.txt"
    localrule: True
    script:
        "eval.py"

rule eval_rscape:
    input:
        scores = "data/{dataset}/rscape_{score}.npz",
        ss = "data/{dataset}/ss.txt",
    output:
        "data/{dataset}/eval_rscape_{score}.txt"
    localrule: True
    script:
        "eval.py"