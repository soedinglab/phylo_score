rule decompress_rfam_seed:
    input:
        "data/Rfam.seed_v15.1.gz"
    output:
        "data/Rfam.seed_v15.1"
    localrule: True
    shell:
        "gzip -cd {input} > {output}"

rule extract_stockholm_alignment:
    input:
        "data/Rfam.seed_v15.1"
    output:
        "data/datasets/{dataset}.sto"
    localrule: True
    shell:
        """
        test -f {input}.ssi || esl-afetch --index {input}
        esl-afetch {input} {wildcards.dataset} > {output}
        """

rule prepare_rfam:
    input:
        "prepare_rfam.py",
        "data/datasets/{dataset}.sto"
    output:
        "data/{dataset, [^/_]+}/alignment.fasta",
        "data/{dataset, [^/_]+}/ss.txt",
        "data/{dataset, [^/_]+}/alignment.sto"
    localrule: True
    shell:
        "python {input[0]} {input[1]} {output[0]} {output[1]} {output[2]}"

rule phylogeny:
    input:
        "data/{dataset}/alignment.fasta"
    output:
        "data/{dataset, [^/]+}/raxml.newick"
    threads: 16
    resources:
        mem_mb = 10000,
        runtime = 100
    shell:
        "raxml-ng --msa {input} --model GTR+G --prefix {output} --seed 1 --redo --msa-format fasta --blopt nr_safe && mv {output}.raxml.bestTree {output}"

# This will only do the cheap calculation of corrections and p_values.
rule run_phylo_score:
    input:
        "data/{dataset}/alignment.fasta",
        "data/{dataset}/raxml.newick",
        "data/{dataset}/reg{reg}_mireg{mireg}_cache.npz",
        "../phylo_score/utils.py"
    output:
        "data/{dataset, [^/]+}/reg{reg}_mireg{mireg}_score{score}_corr{corr, [^_]+}.npz"
    localrule: True
    shell:
        "python -m phylo_score --alignment {input[0]} --tree {input[1]} --lambda {wildcards.reg} --lambda-mi {wildcards.mireg} --score-type {wildcards.score} --correction {wildcards.corr} --p_values fast --output {output}"

# We first run phylo_score to populate the cache which is the expensive run.
# This depends only on the regularization strength and not correction and score type.
rule run_phylo_score_cache:
    input:
        "data/{dataset}/alignment.fasta",
        "data/{dataset}/raxml.newick"
    output:
        "data/{dataset, [^/]+}/reg{reg}_mireg{mireg}_cache.npz"
    threads: 16
    resources:
        mem_mb = 200000,
        runtime = 10000
    shell:
        "python -m phylo_score --alignment {input[0]} --tree {input[1]} --lambda {wildcards.reg} --lambda-mi {wildcards.mireg} --score-type optdiff --correction APC --p_values fast --output {output}"

rule run_phylo_score_with_null:
    input:
        "data/{dataset}/alignment.fasta",
        "data/{dataset}/raxml.newick"
    output:
        "data/{dataset, [^/]+}/reg{reg}_mireg{mireg}_score{score}_corr{corr}_with_null.npz"
    threads: 64
    resources:
        mem_mb = 200000,
        runtime = 10000
    shell:
        "python -m phylo_score --alignment {input[0]} --tree {input[1]} --lambda {wildcards.reg} --lambda-mi {wildcards.mireg} --score-type {wildcards.score} --correction {wildcards.corr} --p_values null_alignment --output {output}"

RF = list(map(str.strip, open("3d.txt", "r")))
RF_null = [f"{dataset}_mynull" for dataset in RF]

rule rscape:
	input:
		"data/{dataset}/alignment.sto"
	output:
		"data/{dataset}/rscape/{score}.cov"
	localrule: True
	shell:
		"./R-scape -E 1001 --outdir data/{wildcards.dataset}/rscape --gapthresh 1.0 --outname {wildcards.score} --{wildcards.score} {input}"

rule extract_rscape:
	input:
		rscape = "data/{dataset}/rscape/{score}.cov"
	output:
		"data/{dataset}/rscape_{score}.npz"
	localrule: True
	script:
		"extract_rscape.py"

comap_variants = ["corr", "corrAPC", "pvalue"]

rule comap:
    input:
        alignment = "data/{dataset}/alignment.fasta",
        tree = "data/{dataset}/raxml.newick",
        param = "comap.bpp"
    output:
        "data/{dataset, [^/]+}/comap/comap.sta"
    resources:
        mem_mb = 10000,
        runtime = 300
    shell:
        "cd data/{wildcards.dataset}/comap && ../../../comap param=../../../{input.param} ALN=../alignment.fasta TREE=../raxml.newick > comap.log"

rule extract_comap:
    input:
        "extract_comap.py",
        "data/{dataset}/comap/comap.sta",
        "data/{dataset}/ss.txt"
    output:
        expand("data/{{dataset, [^/]+}}/comap_{variant}.npz", variant = comap_variants)
    localrule: True
    shell:
        "python {input[0]} {input[1]} {input[2]} {output}"

failed_comap = ["RF00005", "RF03064"]
RF_comap = [dataset for dataset in RF if dataset not in failed_comap]

rule eval_comap:
    input:
        scores = expand("data/{dataset}/comap_{variant}.npz", variant = comap_variants, dataset = RF_comap),
        ss = expand("data/{dataset}/ss.txt", dataset = RF_comap),
    output:
        "data/eval_comap.pickle"
    localrule: True
    script:
        "eval.py"

rscape_scores = ["GTp", "GT", "GTa", "CHIa", "CHIp", "CHI", "MIa", "MIp", "MI", "MIr", "MIrp", "MIra", "MIg", "MIgp", "MIga", "OMES", "OMESa", "OMESp", "CCFp", "CCFa", "CCF"]

rule eval_rscape:
    input:
        scores = expand("data/{dataset}/rscape_{score}.npz", score = rscape_scores, dataset = RF),
        ss = expand("data/{dataset}/ss.txt", dataset = RF),
    output:
        "data/eval_rscape.pickle"
    localrule: True
    script:
        "eval.py"

rule eval_hyper_phyloscore:
    input:
        scores = expand(
            "data/{dataset}/reg{reg}_mireg{mireg}_score{score}_corr{corr}.npz",
            score = ["optdiff", "lldiff"],
            corr = ["APC", "ASC", "None"],
            reg = [0.05,0.1, 0.25, 0.5, 1.0, 2.5, 5.0],
            mireg = [0.0, 0.01, 0.1, 1.0, 10.0],
            dataset = RF
        ),
        ss = expand("data/{dataset}/ss.txt", dataset = RF),
    output:
        "data/eval_phyloscore.pickle"
    localrule: True
    script:
        "eval.py"

rule all_phylo_score:
    input:
        best_scores = expand("data/{dataset}/reg0.5_mireg0.01_scoreoptdiff_corrAPC_with_null.npz", dataset = RF),
        worst_scores = expand("data/{dataset}/reg1.0_mireg1.0_scoreoptdiff_corrAPC_with_null.npz", dataset = RF),
    output:
        "data/run_all_phyloscore"
    localrule: True
    shell:
        "touch {output}"
